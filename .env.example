POSTGRES_PASSWORD=replace-with-a-strong-database-password
ROBOTCARE_DATABASE_URL=postgresql+psycopg://robotcare:replace-with-a-strong-database-password@postgres:5432/robotcare
# 连接池：按「并发聊天数 + 常规请求」估，不是按 CPU 核数。
# 默认 5+10 时约 15 路并发 SSE 就能抽干池子，连登录一起 500。
ROBOTCARE_DB_POOL_SIZE=20
ROBOTCARE_DB_MAX_OVERFLOW=30
ROBOTCARE_DB_POOL_TIMEOUT_SECONDS=10
ROBOTCARE_DB_POOL_RECYCLE_SECONDS=1800
ROBOTCARE_DB_POOL_PRE_PING=true
# Production startup deliberately rejects this placeholder. Replace it with
# at least 32 cryptographically random characters before starting Compose.
ROBOTCARE_JWT_SECRET=replace-with-at-least-32-random-characters
ROBOTCARE_ENVIRONMENT=production
# Production permits only invite or closed registration.
ROBOTCARE_REGISTRATION_MODE=invite
# Production startup rejects this placeholder. Replace it with a random value
# of at least 16 characters, and distribute it out of band.
ROBOTCARE_REGISTRATION_INVITE_SECRET=replace-with-a-random-invite-secret
ROBOTCARE_ACCESS_TOKEN_MINUTES=60
ROBOTCARE_REFRESH_TOKEN_DAYS=14
ROBOTCARE_REFRESH_REUSE_GRACE_SECONDS=5
ROBOTCARE_REFRESH_COOKIE_SECURE=true
ROBOTCARE_LOGIN_MAX_FAILURES=5
ROBOTCARE_LOGIN_EMAIL_MAX_FAILURES=20
ROBOTCARE_LOGIN_IP_MAX_FAILURES=30
ROBOTCARE_LOGIN_WINDOW_MINUTES=15
ROBOTCARE_LOGIN_LOCK_MINUTES=15
# The bundled Compose network pins Nginx to this address. Do not use 0.0.0.0/0.
# 必须同时覆盖 Nginx 容器(172.30.0.10)与 Compose 网关(172.30.0.1)——宿主上的
# TLS 反代经 loopback 进来时源地址是网关。宿主反代必须自己设置 X-Forwarded-For
# （$proxy_add_x_forwarded_for 或等价），否则真实客户端 IP 无从得知。
ROBOTCARE_TRUSTED_PROXY_CIDRS=172.30.0.10/32,172.30.0.1/32
# 成功登录的速率上限（失败计数之外的第二道闸）与每用户会话总数上限
ROBOTCARE_LOGIN_SUCCESS_EMAIL_PER_MINUTE=10
ROBOTCARE_LOGIN_SUCCESS_IP_PER_MINUTE=30
ROBOTCARE_MAX_CONVERSATIONS_PER_USER=200
ROBOTCARE_REGISTRATION_EMAIL_PER_MINUTE=3
ROBOTCARE_REGISTRATION_IP_PER_MINUTE=10
ROBOTCARE_KNOWLEDGE_SEARCH_USER_PER_MINUTE=20
ROBOTCARE_KNOWLEDGE_SEARCH_IP_PER_MINUTE=60
ROBOTCARE_DIAGNOSTIC_CREATE_USER_PER_MINUTE=10
ROBOTCARE_DIAGNOSTIC_CREATE_IP_PER_MINUTE=30
ROBOTCARE_ATTACHMENT_UPLOAD_USER_PER_MINUTE=20
ROBOTCARE_ATTACHMENT_UPLOAD_IP_PER_MINUTE=60
ROBOTCARE_REPORT_CREATE_USER_PER_MINUTE=5
ROBOTCARE_REPORT_CREATE_IP_PER_MINUTE=15
ROBOTCARE_PDF_CREATE_USER_PER_MINUTE=5
ROBOTCARE_PDF_CREATE_IP_PER_MINUTE=15
ROBOTCARE_EMBEDDING_USER_PER_MINUTE=10
ROBOTCARE_EMBEDDING_IP_PER_MINUTE=30
ROBOTCARE_EMBEDDING_USER_PER_DAY=100
ROBOTCARE_EMBEDDING_IP_PER_DAY=300
ROBOTCARE_KNOWLEDGE_SEARCH_CACHE_TTL_SECONDS=30
# 检索缓存条数上限：长尾查询不会二次命中，却会永久占内存，超限按 LRU 淘汰
ROBOTCARE_KNOWLEDGE_SEARCH_CACHE_MAX_ENTRIES=512
# 引用原件按页抽取的缓存与并发闸：避免每次请求都把整本 PDF 解析进内存
ROBOTCARE_CITATION_PAGE_CACHE_MAX_ENTRIES=64
ROBOTCARE_CITATION_PAGE_CACHE_MAX_MB=32
ROBOTCARE_CITATION_PAGE_MAX_CONCURRENT=4
# /ready 的 embedding 可达性探测缓存（healthcheck 每 10s 打一次，不缓存就是烧钱）
ROBOTCARE_READINESS_PROBE_SUCCESS_TTL_SECONDS=300
ROBOTCARE_READINESS_PROBE_FAILURE_TTL_SECONDS=30
ROBOTCARE_CORS_ORIGINS=https://robotcare.example.com
ROBOTCARE_ATTACHMENT_DIR=./data/attachments
ROBOTCARE_REPORT_DIR=./data/reports
ROBOTCARE_AUTO_CREATE_SCHEMA=false
ROBOTCARE_DASHSCOPE_API_KEY=
# DashScope SDK endpoint for the Alibaba Cloud Model Studio workspace/region.
# This is /api/v1, not the OpenAI-compatible /compatible-mode/v1 endpoint.
ROBOTCARE_DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
ROBOTCARE_KNOWLEDGE_MIN_SCORE=0.25
# Optional JSON overrides keyed by model or model:knowledge-document-sha256.
ROBOTCARE_KNOWLEDGE_MIN_SCORE_OVERRIDES={}
# One-shot administrator provisioning only; do not keep this value after use.
# ROBOTCARE_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
# Linux/Docker should point this to a redistributable Chinese TrueType font.
# ROBOTCARE_PDF_FONT_PATH=/app/fonts/NotoSansCJKsc-Regular.otf

# 运营告警（可选）：企业微信/钉钉群机器人 webhook；未配置即关闭
ROBOTCARE_ALERT_WEBHOOK_URL=
ROBOTCARE_ALERT_WEBHOOK_FORMAT=wecom
ROBOTCARE_ALERT_COOLDOWN_SECONDS=14400

# 独立密钥（可选但强烈建议）：不配置时回退 ROBOTCARE_JWT_SECRET，
# 后果是轮换 JWT 密钥会连带清空限流计数、让已发出的报告链接全部失效。
# 配上之后三者可各自独立轮换。启动日志会对未配置状态发 secret_reuse_detected 告警。
ROBOTCARE_RATE_LIMIT_HMAC_SECRET=
ROBOTCARE_REPORT_FILENAME_SECRET=

# 生成后端：dashscope（默认）| openai-compat（DeepSeek 等）
ROBOTCARE_LLM_BACKEND=dashscope
ROBOTCARE_LLM_API_KEY=
ROBOTCARE_LLM_BASE_URL=
ROBOTCARE_GENERATION_MODEL=qwen-plus

# 外部模型超时预算。budget 是含重试在内的总上限，
# 必须小于 frontend/nginx.conf 的 proxy_read_timeout（当前 60s），
# 否则用户已收到 504、后端还在跑并照常计费。CI 会静态断言这条。
ROBOTCARE_LLM_CONNECT_TIMEOUT_SECONDS=5
ROBOTCARE_LLM_READ_TIMEOUT_SECONDS=40
ROBOTCARE_LLM_BUDGET_SECONDS=50
ROBOTCARE_LLM_MAX_ATTEMPTS=2
ROBOTCARE_EMBEDDING_CONNECT_TIMEOUT_SECONDS=5
ROBOTCARE_EMBEDDING_READ_TIMEOUT_SECONDS=20
ROBOTCARE_EMBEDDING_BUDGET_SECONDS=30
ROBOTCARE_EMBEDDING_MAX_ATTEMPTS=2

# 知识问答（生成）限流
ROBOTCARE_KNOWLEDGE_ANSWER_USER_PER_MINUTE=6
ROBOTCARE_KNOWLEDGE_ANSWER_IP_PER_MINUTE=20

# 知识原件存档目录。必须落在持久卷内，否则容器重建即丢失原件，
# 重新向量化 / 下载原件 / 版本回滚会一起失效。
ROBOTCARE_KNOWLEDGE_DIR=/app/data/knowledge

# token 单价（元 / 百万 token）。默认按 qwen-plus 公开价填；
# 换模型必须跟着改，否则成本看板会悄悄失真。
# 按模型精确配置：{"qwen-plus": {"prompt": 0.8, "completion": 2.0}}
ROBOTCARE_LLM_TOKEN_PRICES={}
ROBOTCARE_LLM_DEFAULT_PROMPT_PRICE_PER_MILLION=0.8
ROBOTCARE_LLM_DEFAULT_COMPLETION_PRICE_PER_MILLION=2.0

# 与 JWT 解耦的独立密钥（见上方说明）
