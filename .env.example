ROBOTCARE_DATABASE_URL=sqlite:///./data/robotcare.db
# PostgreSQL target example:
# ROBOTCARE_DATABASE_URL=postgresql+psycopg://robotcare:robotcare@postgres:5432/robotcare
# Docker Compose requires POSTGRES_PASSWORD, ROBOTCARE_DATABASE_URL and
# ROBOTCARE_JWT_SECRET to be supplied from the external environment.
# POSTGRES_PASSWORD=replace-with-a-strong-database-password
ROBOTCARE_JWT_SECRET=replace-with-a-long-random-secret
ROBOTCARE_ACCESS_TOKEN_MINUTES=60
ROBOTCARE_CORS_ORIGINS=http://localhost:5173
ROBOTCARE_ATTACHMENT_DIR=./data/attachments
ROBOTCARE_REPORT_DIR=./data/reports
ROBOTCARE_AUTO_CREATE_SCHEMA=false
ROBOTCARE_DASHSCOPE_API_KEY=
# One-shot administrator provisioning only; do not keep this value after use.
# ROBOTCARE_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
# Linux/Docker should point this to a redistributable Chinese TrueType font.
# ROBOTCARE_PDF_FONT_PATH=/app/fonts/NotoSansCJKsc-Regular.otf
